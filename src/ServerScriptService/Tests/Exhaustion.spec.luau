local Exhaustion = require(game:GetService("ReplicatedStorage"):WaitForChild("Combat"):WaitForChild("Exhaustion"))

return function(Describe, It, Expect)
	local Config = Exhaustion.DefaultConfig -- M1sPerStack 2, HeavyStack 3, Threshold 6

	Describe("stacking", function()
		It("adds a regular stack every M1sPerStack M1s", function()
			local State = Exhaustion.New()
			Expect(Exhaustion.OnM1(State, Config, 0)).ToBe(false)
			Expect(Exhaustion.OnM1(State, Config, 0.3)).ToBe(true)
			Expect(State.Stacks).ToBe(1)
		end)
		It("knockbacks add a heavy stack", function()
			local State = Exhaustion.New()
			Exhaustion.OnKnockback(State, Config, 0)
			Expect(State.Stacks).ToBe(3)
		end)
		It("caps at MaxStacks", function()
			local State = Exhaustion.New()
			Exhaustion.Add(State, Config, 100, 0)
			Expect(State.Stacks).ToBe(Config.MaxStacks)
		end)
	end)

	Describe("debuff intensity", function()
		It("is zero below the threshold", function()
			local State = Exhaustion.New()
			Exhaustion.Add(State, Config, Config.Threshold - 1, 0)
			Expect(Exhaustion.Intensity(State, Config)).ToBe(0)
		end)
		It("scales with each stack past the threshold", function()
			local State = Exhaustion.New()
			Exhaustion.Add(State, Config, Config.Threshold + 2, 0)
			Expect(Exhaustion.Intensity(State, Config)).ToBe(3)
		end)
	end)

	Describe("decay", function()
		It("does not decay while in combat", function()
			local State = Exhaustion.New()
			Exhaustion.Add(State, Config, 5, 0)
			Exhaustion.Tick(State, Config, Config.OutOfCombatDelay - 0.1)
			Expect(State.Stacks).ToBe(5)
		end)
		It("decays one stack per interval out of combat", function()
			local State = Exhaustion.New()
			Exhaustion.Add(State, Config, 5, 0)
			Exhaustion.Tick(State, Config, Config.OutOfCombatDelay + Config.DecayInterval * 2 + 0.01)
			Expect(State.Stacks).ToBe(3)
		end)
		It("a new hit restarts the out-of-combat timer", function()
			local State = Exhaustion.New()
			Exhaustion.Add(State, Config, 5, 0)
			Exhaustion.Add(State, Config, 1, Config.OutOfCombatDelay)
			Exhaustion.Tick(State, Config, Config.OutOfCombatDelay + 1)
			Expect(State.Stacks).ToBe(6)
		end)
	end)
end
