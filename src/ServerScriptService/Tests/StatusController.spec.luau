local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Combat = Shared:WaitForChild("Combat")
local Stats = require(Combat:WaitForChild("Stats"))
local LockProfile = require(Combat:WaitForChild("LockProfile"))
local Config = require(Combat:WaitForChild("CombatConfig"))
local StatusController = require(Shared:WaitForChild("StatusEffects"):WaitForChild("StatusController"))

local Tiers = LockProfile.Tiers

return function(Describe, It, Expect)
	local function New(Base : { [string]: number }?)
		local Events = {}
		local Block = Stats.NewBlock(Base or { AttackSpeed = 1, WalkSpeed = 16, PostureTaken = 1, Tenacity = 0 })
		local S = StatusController.new(Block, function(E)
			table.insert(Events, E.Kind .. ":" .. E.Id)
		end)
		return S, Block, Events
	end

	Describe("stacking", function()
		It("Refresh resets EndsAt", function()
			local S = New()
			S:Apply("Cripple", nil, 0, { Duration = 1 })
			local Inst = S:Apply("Cripple", nil, 0.5, { Duration = 1 })
			Expect(Inst.EndsAt).ToBe(1.5)
			Expect(Inst.Stacks).ToBe(1)
		end)
		It("Intensity caps at MaxStacks and refreshes", function()
			local S = New()
			S:Apply("Exhausted", nil, 0, { Stacks = 9 })
			local Inst = S:Apply("Exhausted", nil, 1, { Stacks = 5 })
			Expect(Inst.Stacks).ToBe(Config.Exhaustion.MaxIntensity)
		end)
		It("Ignore keeps the original", function()
			local S, _, Events = New()
			S:Apply("GuardBroken", nil, 0)
			local Inst = S:Apply("GuardBroken", nil, 0.5, { Duration = 5 })
			Expect(Inst.EndsAt).ToBe(Config.GuardBrokenStun)
			Expect(#Events).ToBe(1)
		end)
		It("Independent keeps separate instances", function()
			local S = New()
			S:Apply("Slow", nil, 0, { Duration = 1, Potency = 0.3 })
			S:Apply("Slow", nil, 0, { Duration = 2, Potency = 0.5 })
			Expect(S:Stacks("Slow")).ToBe(2)
			local Entry = S:Entry("Slow")
			Expect(Entry.Stacks).ToBe(2)
			Expect(Entry.EndsAt).ToBe(2)
		end)
	end)

	Describe("durations", function()
		It("Tenacity shortens TenacityAffected effects only", function()
			local S = New({ Tenacity = 0.5 })
			Expect(S:Apply("Hitstun", nil, 0, { Duration = 1 }).EndsAt).ToBeNear(0.5)
			Expect(S:Apply("Airborne", nil, 0, { Duration = 1 }).EndsAt).ToBe(1)
			Expect(S:Apply("GuardBroken", nil, 0, { Duration = 1 }).EndsAt).ToBe(1)
		end)
		It("Tenacity can't go below MinCCDuration, and short CCs keep their base", function()
			local S = New({ Tenacity = 0.9 })
			Expect(S:Apply("Hitstun", nil, 0, { Duration = 1 }).EndsAt).ToBeNear(Config.Status.MinCCDuration)
			local Short = New({ Tenacity = 0.9 })
			Expect(Short:Apply("Hitstun", nil, 0, { Duration = 0.2 }).EndsAt).ToBeNear(0.2)
		end)
		It("Unstoppable rejects CC but accepts buffs", function()
			local S = New()
			S:Apply("BreakerIFrames", nil, 0)
			Expect(S:Apply("Hitstun", nil, 0)).ToBeNil()
			Expect(S:Apply("DodgeIFrames", nil, 0)).Never.ToBeNil()
			Expect(S:Apply("Slow", nil, 0)).Never.ToBeNil()
		end)
	end)

	Describe("stats", function()
		It("PercentMult compounds per stack and Remove restores exactly", function()
			local S, Block = New()
			S:SetIntensity("Exhausted", 2, 0)
			Expect(Block:Get("AttackSpeed")).ToBeNear((1 - Config.ExhaustedPerLevel.AttackSpeed) ^ 2)
			Expect(Block:Get("PostureTaken")).ToBeNear(1 + 2 * Config.ExhaustedPerLevel.PostureTaken)
			S:SetIntensity("Exhausted", 0, 1)
			Expect(Block:Get("AttackSpeed")).ToBe(1)
			Expect(Block:Get("PostureTaken")).ToBe(1)
			Expect(next(Block.Mods)).ToBeNil()
		end)
		It("only the strongest slow applies", function()
			local S, Block = New()
			S:Apply("Slow", nil, 0, { Duration = 2, Potency = 0.3 })
			S:Apply("Slow", nil, 0, { Duration = 1, Potency = 0.5 })
			Expect(Block:Get("WalkSpeed")).ToBeNear(8)
			S:Update(1)
			Expect(Block:Get("WalkSpeed")).ToBeNear(16 * 0.7)
			S:Update(2)
			Expect(Block:Get("WalkSpeed")).ToBe(16)
		end)
		It("override modifiers replace the def's", function()
			local S, Block = New()
			S:Apply("Cripple", nil, 0, { Modifiers = { { Stat = "AttackSpeed", Kind = "PercentMult", Value = 0.5 } } })
			Expect(Block:Get("AttackSpeed")).ToBeNear(0.5)
		end)
	end)

	Describe("gates", function()
		It("Can and LockTier with overlapping Root and Hitstun", function()
			local S = New()
			Expect(S:LockTier()).ToBe(Tiers.Free)
			S:Apply("Root", nil, 0, { Duration = 2 })
			Expect(S:Can("Move")).ToBe(false)
			Expect(S:Can("Attack")).ToBe(true)
			Expect(S:LockTier()).ToBe(Tiers.Rooted)
			S:Apply("Hitstun", nil, 0, { Duration = 0.5 })
			Expect(S:Can("Attack")).ToBe(false)
			Expect(S:LockTier()).ToBe(Tiers.Locked)
			S:Update(0.5)
			Expect(S:Can("Attack")).ToBe(true)
			Expect(S:LockTier()).ToBe(Tiers.Rooted)
		end)
		It("Has reads tags, Cleanse removes only Cleansable", function()
			local S = New()
			S:Apply("DodgeIFrames", nil, 0)
			S:Apply("Root", nil, 0)
			S:Apply("Stagger", nil, 0)
			Expect(S:Has("Invulnerable")).ToBe(true)
			Expect(S:Cleanse()).ToBe(1)
			Expect(S:Get("Root")).ToBeNil()
			Expect(S:Get("Stagger")).Never.ToBeNil()
		end)
		It("OnDamaged removes BreaksOnDamage effects", function()
			local S = New()
			S:Apply("Hitstun", nil, 0)
			S.Active.Hitstun.Def = table.freeze(setmetatable({ BreaksOnDamage = true }, { __index = S.Active.Hitstun.Def }))
			S:OnDamaged(0.1)
			Expect(S:Get("Hitstun")).ToBeNil()
		end)
	end)

	Describe("time", function()
		It("Update expires on the boundary and fires Removed", function()
			local S, _, Events = New()
			S:Apply("Hitstun", nil, 0, { Duration = 0.5 })
			S:Update(0.49)
			Expect(S:Get("Hitstun")).Never.ToBeNil()
			S:Update(0.5)
			Expect(S:Get("Hitstun")).ToBeNil()
			Expect(Events[#Events]).ToBe("Removed:Hitstun")
		end)
		It("Update returns ticks that came due", function()
			local S = New()
			local Inst = S:Apply("Cripple", nil, 0, { Duration = 1 })
			Inst.Def = table.freeze(setmetatable({ Tick = { Interval = 0.25, Damage = 1 } }, { __index = Inst.Def }))
			Inst.NextTick = 0.25
			Expect(#S:Update(0.6)).ToBe(2)
			Expect(#S:Update(1)).ToBe(2) -- 0.75 and the one on the last frame
		end)
		It("Snapshot lists one row per effect, sorted by NetId", function()
			local S = New()
			S:Apply("DodgeIFrames", nil, 0)
			S:Apply("Hitstun", nil, 0)
			S:Apply("Slow", nil, 0)
			S:Apply("Slow", nil, 0)
			local Rows = S:Snapshot()
			Expect(#Rows).ToBe(3)
			Expect(Rows[1].NetId).ToBe(1)
			Expect(Rows[2].Stacks).ToBe(2)
		end)
	end)
end
