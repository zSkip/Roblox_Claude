local Combat = game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Combat")
local Stats = require(Combat:WaitForChild("Stats"))

return function(Describe, It, Expect)
	Describe("formulas", function()
		It("resist multiplier: 100 armor halves damage, negative amplifies", function()
			Expect(Stats.ResistMultiplier(0)).ToBe(1)
			Expect(Stats.ResistMultiplier(100)).ToBeNear(0.5)
			Expect(Stats.ResistMultiplier(-100)).ToBeNear(1.5)
		end)
		It("penetration: percent first, then flat, never below 0", function()
			Expect(Stats.EffectiveResist(100, 0.3, 10)).ToBeNear(60)
			Expect(Stats.EffectiveResist(20, 0, 50)).ToBe(0)
			Expect(Stats.EffectiveResist(-10, 0.5, 10)).ToBe(-10)
		end)
		It("final damage by type", function()
			local Attacker = { ArmorPenPercent = 0, ArmorPenFlat = 0 }
			local Defender = { Armor = 100, MagicResist = 0 }
			Expect(Stats.FinalDamage(20, "Physical", Attacker, Defender)).ToBeNear(10)
			Expect(Stats.FinalDamage(20, "Magical", Attacker, Defender)).ToBeNear(20)
			Expect(Stats.FinalDamage(20, "True", Attacker, { Armor = 1000 })).ToBe(20)
		end)
		It("tenacity stacks multiplicatively and skips Airborne", function()
			Expect(Stats.CombinedTenacity({ 0.3, 0.3 })).ToBeNear(0.51)
			Expect(Stats.CCDuration(1, 0.5, "Stun")).ToBeNear(0.5)
			Expect(Stats.CCDuration(1, 0.5, "Airborne")).ToBe(1)
		end)
		It("only the strongest slow applies", function()
			Expect(Stats.StrongestSlow({ 0.2, 0.4, 0.1 })).ToBeNear(0.4)
			Expect(Stats.StrongestSlow({ 0.4 }, 0.5)).ToBeNear(0.2)
			Expect(Stats.StrongestSlow({})).ToBe(0)
		end)
		It("cooldowns, attack speed cap and healing", function()
			Expect(Stats.Cooldown(10, 100)).ToBeNear(5)
			Expect(Stats.AttackSpeed(1, 0.25)).ToBeNear(1.25)
			Expect(Stats.AttackSpeed(2, 1)).ToBe(Stats.AttackSpeedCap)
			Expect(Stats.Heal(10, 0.2, 0.4)).ToBeNear(7.2)
		end)
	end)

	Describe("StatBlock", function()
		It("returns the base without modifiers, 0 for unknown stats", function()
			local Block = Stats.NewBlock({ Armor = 20 })
			Expect(Block:Get("Armor")).ToBe(20)
			Expect(Block:Get("MagicResist")).ToBe(0)
		end)
		It("(base + flat) x (1 + sum %) x product mult", function()
			local Block = Stats.NewBlock({ AttackDamage = 50 })
			Block:AddModifier("ring", { Stat = "AttackDamage", Kind = "Flat", Value = 10 })
			Block:AddModifier("buffA", { Stat = "AttackDamage", Kind = "PercentAdd", Value = 0.1 })
			Block:AddModifier("buffB", { Stat = "AttackDamage", Kind = "PercentAdd", Value = 0.15 })
			Block:AddModifier("exhausted", { Stat = "AttackDamage", Kind = "PercentMult", Value = 0.8 })
			Expect(Block:Get("AttackDamage")).ToBeNear(60 * 1.25 * 0.8)
		end)
		It("removing a modifier invalidates the cache", function()
			local Block = Stats.NewBlock({ Armor = 20 })
			Block:AddModifier("a", { Stat = "Armor", Kind = "Flat", Value = 5 })
			Expect(Block:Get("Armor")).ToBe(25)
			Expect(Block:RemoveModifier("a")).ToBe(true)
			Expect(Block:Get("Armor")).ToBe(20)
			Expect(Block:RemoveModifier("a")).ToBe(false)
		end)
		It("re-adding an id replaces it, even across stats", function()
			local Block = Stats.NewBlock({ Armor = 20, MagicResist = 10 })
			Block:AddModifier("x", { Stat = "Armor", Kind = "Flat", Value = 5 })
			Block:AddModifier("x", { Stat = "MagicResist", Kind = "Flat", Value = 5 })
			Expect(Block:Get("Armor")).ToBe(20)
			Expect(Block:Get("MagicResist")).ToBe(15)
		end)
		It("lowest override wins over everything", function()
			local Block = Stats.NewBlock({ WalkSpeed = 16 })
			Block:AddModifier("haste", { Stat = "WalkSpeed", Kind = "PercentAdd", Value = 0.5 })
			Block:AddModifier("root", { Stat = "WalkSpeed", Kind = "Override", Value = 5 })
			Block:AddModifier("stun", { Stat = "WalkSpeed", Kind = "Override", Value = 0 })
			Expect(Block:Get("WalkSpeed")).ToBe(0)
			Block:RemoveModifier("stun")
			Expect(Block:Get("WalkSpeed")).ToBe(5)
		end)
		It("clamps to bounds", function()
			local Block = Stats.NewBlock({ WalkSpeed = 16 }, { WalkSpeed = { Min = 4, Max = 22 } })
			Block:AddModifier("slow", { Stat = "WalkSpeed", Kind = "PercentMult", Value = 0.1 })
			Expect(Block:Get("WalkSpeed")).ToBe(4)
			Block:RemoveModifier("slow")
			Block:AddModifier("haste", { Stat = "WalkSpeed", Kind = "PercentAdd", Value = 1 })
			Expect(Block:Get("WalkSpeed")).ToBe(22)
		end)
		It("RemoveSource drops every modifier of an effect", function()
			local Block = Stats.NewBlock({ AttackSpeed = 1, WalkSpeed = 16 })
			Block:AddModifier("ex.as", { Stat = "AttackSpeed", Kind = "PercentMult", Value = 0.9, Source = "Exhausted" })
			Block:AddModifier("ex.ws", { Stat = "WalkSpeed", Kind = "PercentMult", Value = 0.9, Source = "Exhausted" })
			Block:AddModifier("item", { Stat = "WalkSpeed", Kind = "Flat", Value = 1, Source = "Boots" })
			Expect(Block:RemoveSource("Exhausted")).ToBe(2)
			Expect(Block:Get("AttackSpeed")).ToBe(1)
			Expect(Block:Get("WalkSpeed")).ToBe(17)
		end)
		It("OnChanged fires only when a value changes", function()
			local Log = {}
			local Block = Stats.NewBlock({ Armor = 20 }, nil, function(Stat, Value)
				table.insert(Log, `{Stat}={Value}`)
			end)
			Block:AddModifier("a", { Stat = "Armor", Kind = "Flat", Value = 5 })
			Block:AddModifier("b", { Stat = "Armor", Kind = "Flat", Value = 0 })
			Block:SetBase("Armor", 30)
			Expect(Log).ToEqual({ "Armor=25", "Armor=35" })
		end)
		It("Snapshot feeds FinalDamage", function()
			local Defender = Stats.NewBlock({ Armor = 50 })
			Defender:AddModifier("shred", { Stat = "Armor", Kind = "Flat", Value = 50 })
			local Snap = Defender:Snapshot()
			Expect(Snap.Armor).ToBe(100)
			Expect(Stats.FinalDamage(10, "Physical", {}, Snap)).ToBeNear(5)
		end)
	end)
end
