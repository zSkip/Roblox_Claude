--!strict
-- Studio-only tool: bakes ReplicatedStorage.Assets.Animations into Shared.Combat.AnimationManifest so
-- both sides know every animation's length and marker times without playing it.
-- Run from the command bar after uploading or editing animations:
--   require(game.ServerScriptService.Tools.AnimationBake).Run()
-- Markers the combat code reads: "Windup" (first hit frame) and "HitEnd" (last hit frame). Without them
-- the last CombatConfig.Animation.HitFrames frames count as the hit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")

local AnimationBake = {}

local function Num(V : number) : string
	local S = string.format("%.4f", V):gsub("0+$", ""):gsub("%.$", "")
	return S
end

function AnimationBake.Run() : string
	local Folder = ReplicatedStorage.Assets.Animations
	local Animations = {}
	for _, A in Folder:GetChildren() do
		if A:IsA("Animation") then
			table.insert(Animations, A)
		end
	end
	table.sort(Animations, function(X, Y)
		return X.Name < Y.Name
	end)

	local Lines = {}
	for _, A in Animations do
		local Sequence = KeyframeSequenceProvider:GetKeyframeSequenceAsync(A.AnimationId)
		local Length = 0
		local Markers = {}
		for _, K in Sequence:GetKeyframes() do
			local Key = K :: Keyframe
			Length = math.max(Length, Key.Time)
			for _, M in Key:GetMarkers() do
				table.insert(Markers, `{M.Name} = {Num(Key.Time)}`)
			end
		end
		table.sort(Markers)
		local MarkerList = if #Markers > 0 then `\{ {table.concat(Markers, ", ")} }` else "{}"
		table.insert(Lines, `\t\t["{A.AnimationId}"] = \{ Name = "{A.Name}", Length = {Num(Length)}, Looped = {tostring(Sequence.Loop)}, Markers = {MarkerList} },`)
	end

	local Source = table.concat({
		"--!strict",
		"-- GENERATED by ServerScriptService.Tools.AnimationBake from ReplicatedStorage.Assets.Animations.",
		"-- Rerun the bake after uploading or editing animations; don't edit by hand.",
		"-- Length and marker times are seconds at speed 1, authored at Fps frames per second.",
		"",
		"return table.freeze({",
		"\tFps = 60,",
		"\tById = table.freeze({",
		table.concat(Lines, "\n"),
		"\t}),",
		"})",
		"",
	}, "\n")
	ReplicatedStorage.Shared.Combat.AnimationManifest.Source = Source
	return Source
end

return AnimationBake
